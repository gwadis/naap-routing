APP_NAME="NAAP Routing"
APP_ENV=production
APP_KEY=base64:IQqCtWT58TRW7uM63u6YflK6jtq+nLi4v87iDCAHWjo=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=https://naaprouting.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Coolify & Docker Deployment Settings ---
APP_PORT=80
FORWARD_DB_PORT=3306
RUN_MIGRATIONS=true
RUN_SEEDER=false

# --- Database Configuration ---
DB_CONNECTION=mysql
DB_URL=mysql://mysql:naap-routing-mysql@ssfcaxpxkucdazc9tlgubdtb:3306/default
DB_HOST=ssfcaxpxkucdazc9tlgubdtb
DB_PORT=3306
DB_DATABASE=default
DB_USERNAME=mysql
DB_PASSWORD=naap-routing-mysql

# --- Session, Cache & Queue ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=file

# --- Email & SMTP Configuration ---
